FIREWORKS_API_KEY=your_fireworks_api_key
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Use only model IDs supplied by the evaluation harness at runtime.
ALLOWED_MODELS=model-id-provided-by-the-harness

# Optional task-specific choice. It must exactly match an ID in ALLOWED_MODELS.
FIREWORKS_CODEGEN_MODEL=model-id-provided-by-the-harness
